  border: 0;

  border-radius: 8px;

  padding: 9px 16px;

  cursor: pointer;

  font-family: inherit;

  font-weight: 700;

}


@media (max-width: 760px) {

  .pdf-reader-page {

    padding: 5px;

  }


  .pdf-reader-top {

    padding: 8px;

  }


  .pdf-reader-title-box h1 {

    font-size: 17px;

  }


  .pdf-page-wrapper {

    min-height: 400px;

    margin-bottom: 8px;

  }


  .pdf-page-loading {

    min-height: 400px;

  }

}

</style>
