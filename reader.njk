layout: base.njk
title: قارئ الكتب والروايات
description: قراءة الكتب والروايات
permalink: /reader/index.html
---

<section class="pdf-reader-page">

  <div class="pdf-reader-top">

    <div class="pdf-reader-title-box">

      <h1 id="readerTitle">
        جاري تحميل الكتاب...
      </h1>

      <span id="readerInfo"></span>

    </div>

  </div>


  <div
    id="readerLoading"
    class="pdf-reader-message"
  >
    جاري تحميل الكتاب...
  </div>


  <div
    id="readerError"
    class="pdf-reader-message"
    hidden
  >
    تعذر فتح الكتاب.
  </div>


  <div
    id="pdfPages"
    class="pdf-pages"
  ></div>

</section>


<script type="module">

/*
  PDF.js
  نستخدم ملفات الحزمة من نفس المصدر حتى تكون
  ملفات CMap والخطوط متوافقة مع إصدار PDF.js.
*/

const PDFJS_VERSION = "4.10.38";

const PDFJS_BASE =
  `https://cdn.jsdelivr.net/npm/pdfjs-dist@${PDFJS_VERSION}/`;


const pdfjsLib =
  await import(
    `${PDFJS_BASE}build/pdf.min.mjs`
  );


pdfjsLib.GlobalWorkerOptions.workerSrc =
  `${PDFJS_BASE}build/pdf.worker.min.mjs`;


/* =========================================================
   البيانات
   ========================================================= */

const params =
  new URLSearchParams(
    window.location.search
  );


const pdfUrl =
  params.get("url");


const bookTitle =
  params.get("title");


const titleElement =
  document.getElementById(
    "readerTitle"
  );


const infoElement =
  document.getElementById(
    "readerInfo"
  );


const loadingElement =
  document.getElementById(
    "readerLoading"
  );


const errorElement =
  document.getElementById(
    "readerError"
  );


const pagesContainer =
  document.getElementById(
    "pdfPages"
  );


/* =========================================================
   العنوان
   ========================================================= */

if (bookTitle) {

  titleElement.textContent =
    bookTitle;

  document.title =
    bookTitle;

} else {

  titleElement.textContent =
    "قراءة الكتاب";

}


/* =========================================================
   متغيرات القارئ
   ========================================================= */

let pdfDocument = null;

let observer = null;

const renderingPages =
  new Set();


/* =========================================================
   عرض صفحة واحدة
   ========================================================= */

async function renderPage(
  pageNumber,
  wrapper
) {

  if (
    !pdfDocument ||
    renderingPages.has(pageNumber) ||
    wrapper.dataset.rendered === "true"
  ) {

    return;

  }


  renderingPages.add(
    pageNumber
  );


  try {

    const page =
      await pdfDocument.getPage(
        pageNumber
      );


    const baseViewport =
      page.getViewport({
        scale: 1
      });


    const availableWidth =
      Math.min(
        document.documentElement.clientWidth - 16,
        1000
      );


    const scale =
      availableWidth /
      baseViewport.width;


    const viewport =
      page.getViewport({
        scale: scale
      });


    const canvas =
      document.createElement(
        "canvas"
      );


    canvas.className =
      "pdf-page";


    const context =
      canvas.getContext(
        "2d",
        {
          alpha: false
        }
      );


    /*
      نحد Pixel Ratio حتى لا تستهلك الروايات
      الطويلة ذاكرة كبيرة على الجوال.
    */

    const pixelRatio =
      Math.min(
        window.devicePixelRatio || 1,
        1.5
      );


    canvas.width =
      Math.floor(
        viewport.width *
        pixelRatio
      );


    canvas.height =
      Math.floor(
        viewport.height *
        pixelRatio
      );


    canvas.style.width =
      `${viewport.width}px`;


    canvas.style.height =
      `${viewport.height}px`;


    wrapper.innerHTML = "";


    wrapper.appendChild(
      canvas
    );


    /*
      important:
      لا نستخدم Text Layer.

      يتم رسم الصفحة الأصلية مباشرة على Canvas
      للمحافظة قدر الإمكان على شكل الخط العربي
      الموجود داخل ملف PDF.
    */

    const renderContext = {

      canvasContext:
        context,

      viewport:
        viewport,

      transform:
        pixelRatio !== 1
          ? [
              pixelRatio,
              0,
              0,
              pixelRatio,
              0,
              0
            ]
          : null,

      intent:
        "display"

    };


    await page.render(
      renderContext
    ).promise;


    wrapper.dataset.rendered =
      "true";


    wrapper.style.minHeight =
      `${viewport.height}px`;


    page.cleanup();


  } catch (error) {

    console.error(
      `PDF page ${pageNumber} error:`,
      error
    );


    wrapper.innerHTML = `
      <div class="pdf-page-error">

        <div>
          تعذر تحميل الصفحة ${pageNumber}
        </div>

        <button
          type="button"
          class="pdf-retry-btn"
        >
          إعادة المحاولة
        </button>

      </div>
    `;


    const retryButton =
      wrapper.querySelector(
        ".pdf-retry-btn"
      );


    if (retryButton) {

      retryButton.addEventListener(
        "click",
        function () {

          wrapper.innerHTML =
            `
              <div class="pdf-page-loading">
                جاري تحميل الصفحة
                ${pageNumber}...
              </div>
            `;


          renderPage(
            pageNumber,
            wrapper
          );

        }
      );

    }


  } finally {

    renderingPages.delete(
      pageNumber
    );

  }

}


/* =========================================================
   تحرير الصفحات البعيدة
   ========================================================= */

function releaseFarPages() {

  const wrappers =
    document.querySelectorAll(
      ".pdf-page-wrapper"
    );


  const screenHeight =
    window.innerHeight;


  wrappers.forEach(
    wrapper => {

      if (
        wrapper.dataset.rendered !==
        "true"
      ) {

        return;

      }


      const rect =
        wrapper.getBoundingClientRect();


      /*
        نحذف Canvas للصفحات البعيدة جدًا
        لتقليل استهلاك الذاكرة.
      */

      if (
        rect.bottom <
          -screenHeight * 4 ||
        rect.top >
          screenHeight * 5
      ) {

        const canvas =
          wrapper.querySelector(
            "canvas"
          );


        if (canvas) {

          canvas.width = 1;

          canvas.height = 1;

        }


        wrapper.innerHTML = `
          <div class="pdf-page-loading">
            الصفحة
            ${wrapper.dataset.page}
          </div>
        `;


        wrapper.dataset.rendered =
          "false";

      }

    }
  );

}


/* =========================================================
   تجهيز أماكن الصفحات
   ========================================================= */

function createPagePlaceholders(
  numberOfPages
) {

  const fragment =
    document.createDocumentFragment();


  for (
    let pageNumber = 1;
    pageNumber <= numberOfPages;
    pageNumber++
  ) {

    const wrapper =
      document.createElement(
        "div"
      );


    wrapper.className =
      "pdf-page-wrapper";


    wrapper.dataset.page =
      pageNumber;


    wrapper.dataset.rendered =
      "false";


    wrapper.innerHTML = `
      <div class="pdf-page-loading">
        الصفحة ${pageNumber}
      </div>
    `;


    fragment.appendChild(
      wrapper
    );

  }


  pagesContainer.appendChild(
    fragment
  );

}


/* =========================================================
   مراقبة الصفحات
   ========================================================= */

function startObserver() {

  observer =
    new IntersectionObserver(

      entries => {

        entries.forEach(
          entry => {

            if (
              entry.isIntersecting
            ) {

              const wrapper =
                entry.target;


              const pageNumber =
                Number(
                  wrapper.dataset.page
                );


              renderPage(
                pageNumber,
                wrapper
              );

            }

          }
        );


        releaseFarPages();

      },

      {

        root:
          null,

        /*
          يبدأ تحميل الصفحات قبل أن يصل إليها
          المستخدم أثناء التمرير.
        */

        rootMargin:
          "1500px 0px 1500px 0px",

        threshold:
          0.01

      }

    );


  document
    .querySelectorAll(
      ".pdf-page-wrapper"
    )
    .forEach(
      wrapper => {

        observer.observe(
          wrapper
        );

      }
    );

}


/* =========================================================
   تحميل ملف PDF
   ========================================================= */

async function loadPDF() {

  if (!pdfUrl) {

    loadingElement.hidden =
      true;


    errorElement.hidden =
      false;


    return;

  }


  try {

    /*
      إعدادات مهمة للملفات العربية.

      cMapUrl:
      يوفر خرائط الأحرف التي تحتاجها بعض
      ملفات PDF ذات الترميزات الخاصة.

      standardFontDataUrl:
      يوفر بيانات الخطوط القياسية لـ PDF.js.

      useSystemFonts:
      يسمح بالاستفادة من خطوط الجهاز عند
      الحاجة إلى خط بديل.

      disableFontFace = false:
      يسمح لـ PDF.js باستخدام الخطوط المضمنة
      داخل ملف PDF.
    */

    const loadingTask =
      pdfjsLib.getDocument({

        url:
          pdfUrl,


        cMapUrl:
          `${PDFJS_BASE}cmaps/`,


        cMapPacked:
          true,


        standardFontDataUrl:
          `${PDFJS_BASE}standard_fonts/`,


        wasmUrl:
          `${PDFJS_BASE}wasm/`,


        useSystemFonts:
          true,


        disableFontFace:
          false,


        disableAutoFetch:
          false,


        disableStream:
          false,


        disableRange:
          false

      });


    pdfDocument =
      await loadingTask.promise;


    infoElement.textContent =
      `${pdfDocument.numPages} صفحة`;


    createPagePlaceholders(
      pdfDocument.numPages
    );


    loadingElement.hidden =
      true;


    startObserver();


  } catch (error) {

    console.error(
      "PDF reader error:",
      error
    );


    loadingElement.hidden =
      true;


    errorElement.hidden =
      false;

  }

}


/* =========================================================
   إعادة ضبط الصفحات عند تغيير حجم الشاشة
   ========================================================= */

let resizeTimer = null;


window.addEventListener(
  "resize",
  function () {

    clearTimeout(
      resizeTimer
    );


    resizeTimer =
      setTimeout(
        function () {

          document
            .querySelectorAll(
              ".pdf-page-wrapper"
            )
            .forEach(
              wrapper => {

                const canvas =
                  wrapper.querySelector(
                    "canvas"
                  );


                if (canvas) {

                  canvas.width = 1;

                  canvas.height = 1;

                }


                wrapper.dataset.rendered =
                  "false";


                wrapper.innerHTML = `
                  <div class="pdf-page-loading">
                    الصفحة
                    ${wrapper.dataset.page}
                  </div>
                `;

              }
            );


          if (observer) {

            observer.disconnect();

          }


          startObserver();

        },
        300
      );

  }
);


/* =========================================================
   تنظيف الذاكرة عند الخروج
   ========================================================= */

window.addEventListener(
  "beforeunload",
  function () {

    if (observer) {

      observer.disconnect();

    }


    if (pdfDocument) {

      try {

        pdfDocument.cleanup();

      } catch (e) {}

    }

  }
);


/* =========================================================
   تشغيل القارئ
   ========================================================= */

loadPDF();

</script>


<style>

