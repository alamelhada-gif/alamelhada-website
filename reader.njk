<section class="pdf-reader-page">

  <div class="pdf-reader-top">
    <button type="button" onclick="history.back()" class="pdf-back-btn">
      رجوع
    </button>

    <h1 id="readerTitle">جاري تحميل الكتاب...</h1>
  </div>

  <div id="readerLoading" class="pdf-reader-message">
    جاري تحميل الصفحات...
  </div>

  <div id="readerError" class="pdf-reader-message" hidden>
    تعذر فتح الكتاب.
  </div>

  <div id="pdfPages" class="pdf-pages"></div>

</section>

<script type="module">

import * as pdfjsLib from
  "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.10.38/pdf.min.mjs";

pdfjsLib.GlobalWorkerOptions.workerSrc =
  "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.10.38/pdf.worker.min.mjs";


const params = new URLSearchParams(window.location.search);

const pdfUrl = params.get("url");
const bookTitle = params.get("title");

const titleElement =
  document.getElementById("readerTitle");

const loadingElement =
  document.getElementById("readerLoading");

const errorElement =
  document.getElementById("readerError");

const pagesContainer =
  document.getElementById("pdfPages");


if (bookTitle) {

  titleElement.textContent = bookTitle;
  document.title = bookTitle;

} else {

  titleElement.textContent = "قراءة الكتاب";

}


async function renderPDF() {

  if (!pdfUrl) {

    loadingElement.hidden = true;
    errorElement.hidden = false;

    return;
  }


  try {

    const loadingTask =
      pdfjsLib.getDocument(pdfUrl);

    const pdf =
      await loadingTask.promise;


    loadingElement.hidden = true;


    for (
      let pageNumber = 1;
      pageNumber <= pdf.numPages;
      pageNumber++
    ) {

      const page =
        await pdf.getPage(pageNumber);


      const baseViewport =
        page.getViewport({
          scale: 1
        });


      const availableWidth =
        Math.min(
          window.innerWidth - 20,
          1000
        );


      const scale =
        availableWidth /
        baseViewport.width;


      const viewport =
        page.getViewport({
          scale: scale
        });


      const wrapper =
        document.createElement("div");

      wrapper.className =
        "pdf-page-wrapper";


      const canvas =
        document.createElement("canvas");

      canvas.className =
        "pdf-page";


      const context =
        canvas.getContext("2d");


      const pixelRatio =
        window.devicePixelRatio || 1;


      canvas.width =
        Math.floor(
          viewport.width *
          pixelRatio
        );


      canvas.height =
        Math.floor(
          viewport.height *
          pixelRatio
        );


      canvas.style.width =
        `${viewport.width}px`;


      canvas.style.height =
        `${viewport.height}px`;


      wrapper.appendChild(canvas);

      pagesContainer.appendChild(wrapper);


      await page.render({

        canvasContext: context,

        viewport: viewport,

        transform:
          pixelRatio !== 1
            ? [
                pixelRatio,
                0,
                0,
                pixelRatio,
                0,
                0
              ]
            : null

      }).promise;

    }


  } catch (error) {

    console.error(
      "PDF reader error:",
      error
    );

    loadingElement.hidden = true;
    errorElement.hidden = false;

  }

}


renderPDF();

</script>


<style>

.pdf-reader-page {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 15px;
  box-sizing: border-box;
}


.pdf-reader-top {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
}


.pdf-reader-top h1 {
  margin: 0;
  font-size: 22px;
}


.pdf-back-btn {
  border: 0;
  border-radius: 10px;
  padding: 10px 18px;
  cursor: pointer;
  font-family: inherit;
  font-weight: 700;
}


.pdf-reader-message {
  text-align: center;
  padding: 50px 20px;
  font-size: 18px;
}


.pdf-pages {
  width: 100%;
}


.pdf-page-wrapper {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 15px;
}


.pdf-page {
  display: block;
  max-width: 100%;
  height: auto;
  background: white;
  box-shadow:
    0 2px 12px
    rgba(0,0,0,.12);
}


@media (max-width: 760px) {

  .pdf-reader-page {
    padding: 5px;
  }


  .pdf-reader-top {
    padding: 8px;
  }


  .pdf-reader-top h1 {
    font-size: 17px;
  }


  .pdf-back-btn {
    padding: 8px 13px;
  }


  .pdf-page-wrapper {
    margin-bottom: 8px;
  }

}

</style>
