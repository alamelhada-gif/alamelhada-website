  display: flex;

  align-items: center;

  margin-bottom: 20px;

}


.pdf-reader-title-box {

  flex: 1;

  min-width: 0;

}


.pdf-reader-title-box h1 {

  margin: 0 0 5px;

  font-size: 22px;

}


#readerInfo {

  font-size: 14px;

  opacity: .7;

}


.pdf-reader-message {

  text-align: center;

  padding: 50px 20px;

  font-size: 18px;

}


.pdf-pages {

  width: 100%;

}


.pdf-page-wrapper {

  width: 100%;

  min-height: 500px;

  display: flex;

  align-items: center;

  justify-content: center;

  margin-bottom: 15px;

}


.pdf-page {

  display: block;

  max-width: 100%;

  height: auto;

  background: white;

  box-shadow:
    0 2px 12px
    rgba(0,0,0,.12);

}


.pdf-page-loading {

  width: 100%;

  min-height: 500px;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #f5f5f5;

  font-size: 14px;

  opacity: .7;

}


.pdf-page-error {

  width: 100%;

  min-height: 300px;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  gap: 15px;

}


