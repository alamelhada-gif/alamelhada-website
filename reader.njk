layout: base.njk
title: قارئ الكتب والروايات
description: قراءة الكتب والروايات
permalink: /reader/index.html
---

<section class="pdf-reader-page">

  <div class="pdf-reader-top">

    <div class="pdf-reader-title-box">

      <h1 id="readerTitle">
        جاري تحميل الكتاب...
      </h1>

      <span id="readerInfo"></span>

    </div>

  </div>


  <div
    id="readerLoading"
    class="pdf-reader-message"
  >
    جاري تحميل الكتاب...
  </div>


  <div
    id="readerError"
    class="pdf-reader-message"
    hidden
  >
    تعذر فتح الكتاب.
  </div>


  <div
    id="pdfPages"
    class="pdf-pages"
  ></div>

</section>


<script type="module">

import * as pdfjsLib from
  "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.10.38/pdf.min.mjs";


pdfjsLib.GlobalWorkerOptions.workerSrc =
  "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.10.38/pdf.worker.min.mjs";


/* =========================================================
   البيانات
   ========================================================= */

const params =
  new URLSearchParams(
    window.location.search
  );


const pdfUrl =
  params.get("url");


const bookTitle =
  params.get("title");


const titleElement =
  document.getElementById(
    "readerTitle"
  );


const infoElement =
  document.getElementById(
    "readerInfo"
  );


const loadingElement =
  document.getElementById(
    "readerLoading"
  );


const errorElement =
  document.getElementById(
    "readerError"
  );


const pagesContainer =
  document.getElementById(
    "pdfPages"
  );


/* =========================================================
   العنوان
   ========================================================= */

if (bookTitle) {

  titleElement.textContent =
    bookTitle;

  document.title =
    bookTitle;

} else {

  titleElement.textContent =
    "قراءة الكتاب";

}


/* =========================================================
   متغيرات القارئ
   ========================================================= */

let pdfDocument = null;

let observer = null;

const renderingPages =
  new Set();


/* =========================================================
   عرض صفحة واحدة
   ========================================================= */

async function renderPage(
  pageNumber,
  wrapper
) {

  if (
    !pdfDocument ||
    renderingPages.has(pageNumber) ||
    wrapper.dataset.rendered === "true"
  ) {
    return;
  }


  renderingPages.add(
    pageNumber
  );


  try {

    const page =
      await pdfDocument.getPage(
        pageNumber
      );


    const baseViewport =
      page.getViewport({
        scale: 1
      });


    const availableWidth =
      Math.min(
        document.documentElement.clientWidth - 16,
        1000
      );


    const scale =
      availableWidth /
      baseViewport.width;


    const viewport =
      page.getViewport({
        scale: scale
      });


    const canvas =
      document.createElement(
        "canvas"
      );


    canvas.className =
      "pdf-page";


    const context =
      canvas.getContext(
        "2d",
        {
          alpha: false
        }
      );


    /*
      نحد Pixel Ratio على الجوال.
      هذا يقلل استهلاك الذاكرة بشكل كبير
      مع الروايات الكبيرة.
    */

    const pixelRatio =
      Math.min(
        window.devicePixelRatio || 1,
        1.5
      );


    canvas.width =
      Math.floor(
        viewport.width *
        pixelRatio
      );


    canvas.height =
      Math.floor(
        viewport.height *
        pixelRatio
      );


    canvas.style.width =
      `${viewport.width}px`;


    canvas.style.height =
      `${viewport.height}px`;


    wrapper.innerHTML = "";

    wrapper.appendChild(
      canvas
    );


    await page.render({

      canvasContext:
        context,

      viewport:
        viewport,

      transform:
        pixelRatio !== 1
          ? [
              pixelRatio,
              0,
              0,
              pixelRatio,
              0,
              0
            ]
          : null

    }).promise;


    wrapper.dataset.rendered =
      "true";


    wrapper.style.minHeight =
      `${viewport.height}px`;


    page.cleanup();


  } catch (error) {

    console.error(
      `PDF page ${pageNumber} error:`,
      error
    );


    wrapper.innerHTML = `
      <div class="pdf-page-error">
        تعذر تحميل الصفحة ${pageNumber}

        <button
          type="button"
          class="pdf-retry-btn"
        >
          إعادة المحاولة
        </button>
      </div>
    `;


    const retryButton =
      wrapper.querySelector(
        ".pdf-retry-btn"
      );


    if (retryButton) {

      retryButton.addEventListener(
        "click",
        function () {

          wrapper.innerHTML =
            `<div class="pdf-page-loading">
              جاري تحميل الصفحة ${pageNumber}...
            </div>`;


          renderPage(
            pageNumber,
            wrapper
          );

        }
      );

    }

  } finally {

    renderingPages.delete(
      pageNumber
    );

  }

}


/* =========================================================
   تحرير الصفحات البعيدة
   ========================================================= */

function releaseFarPages() {

  const wrappers =
    document.querySelectorAll(
      ".pdf-page-wrapper"
    );


  const screenHeight =
    window.innerHeight;


  wrappers.forEach(
    wrapper => {

      if (
        wrapper.dataset.rendered !==
        "true"
      ) {
        return;
      }


      const rect =
        wrapper.getBoundingClientRect();


      /*
        نبقي عدة شاشات قبل وبعد
        موضع المستخدم.
      */

      if (
        rect.bottom <
          -screenHeight * 4 ||
        rect.top >
          screenHeight * 5
      ) {

        const canvas =
          wrapper.querySelector(
            "canvas"
          );


        if (canvas) {

          canvas.width = 1;
          canvas.height = 1;

        }


        wrapper.innerHTML = `
          <div class="pdf-page-loading">
            الصفحة
            ${wrapper.dataset.page}
          </div>
        `;


        wrapper.dataset.rendered =
          "false";

      }

    }
  );

}


/* =========================================================
   تجهيز أماكن الصفحات
   ========================================================= */

function createPagePlaceholders(
  numberOfPages
) {

  const fragment =
    document.createDocumentFragment();


  for (
    let pageNumber = 1;
    pageNumber <= numberOfPages;
    pageNumber++
  ) {

    const wrapper =
      document.createElement(
        "div"
      );


    wrapper.className =
      "pdf-page-wrapper";


    wrapper.dataset.page =
      pageNumber;


    wrapper.dataset.rendered =
      "false";


    wrapper.innerHTML = `
      <div class="pdf-page-loading">
        الصفحة ${pageNumber}
      </div>
    `;


    fragment.appendChild(
      wrapper
    );

  }


  pagesContainer.appendChild(
    fragment
  );

}


/* =========================================================
   مراقبة الصفحات
   ========================================================= */

function startObserver() {

  observer =
    new IntersectionObserver(

      entries => {

        entries.forEach(
          entry => {

            if (
              entry.isIntersecting
            ) {

              const wrapper =
                entry.target;


              const pageNumber =
                Number(
                  wrapper.dataset.page
                );


              renderPage(
                pageNumber,
                wrapper
              );

            }

          }
        );


        releaseFarPages();

      },

      {

        root: null,

        rootMargin:
          "1500px 0px 1500px 0px",

        threshold: 0.01

      }

    );


  document
    .querySelectorAll(
      ".pdf-page-wrapper"
    )
    .forEach(
      wrapper => {

        observer.observe(
          wrapper
        );

      }
    );

}


/* =========================================================
   تحميل ملف PDF
   ========================================================= */

async function loadPDF() {

  if (!pdfUrl) {

    loadingElement.hidden =
      true;

    errorElement.hidden =
      false;

    return;
  }


  try {

    const loadingTask =
      pdfjsLib.getDocument({

        url: pdfUrl,

        disableAutoFetch: false,

        disableStream: false,

        disableRange: false

      });


    pdfDocument =
      await loadingTask.promise;


    infoElement.textContent =
      `${pdfDocument.numPages} صفحة`;


    createPagePlaceholders(
      pdfDocument.numPages
    );


    loadingElement.hidden =
      true;


    startObserver();


  } catch (error) {

    console.error(
      "PDF reader error:",
      error
    );


    loadingElement.hidden =
      true;


    errorElement.hidden =
      false;

  }

}


/* =========================================================
   تنظيف الذاكرة عند الخروج
   ========================================================= */

window.addEventListener(
  "beforeunload",
  function () {

    if (observer) {
      observer.disconnect();
    }


    if (pdfDocument) {

      try {

        pdfDocument.cleanup();

      } catch (e) {}

    }

  }
);


/* =========================================================
   تشغيل القارئ
   ========================================================= */

loadPDF();

</script>


<style>

.pdf-reader-page {

  width: 100%;

  max-width: 1100px;

  margin: 0 auto;

  padding: 15px;

  box-sizing: border-box;

}


.pdf-reader-top {

  display: flex;

  align-items: center;

  margin-bottom: 20px;

}


.pdf-reader-title-box {

  flex: 1;

  min-width: 0;

}


.pdf-reader-title-box h1 {

  margin: 0 0 5px;

  font-size: 22px;

}


#readerInfo {

  font-size: 14px;

  opacity: .7;

}


.pdf-reader-message {

  text-align: center;

  padding: 50px 20px;

  font-size: 18px;

}


.pdf-pages {

  width: 100%;

}


.pdf-page-wrapper {

  width: 100%;

  min-height: 500px;

  display: flex;

  align-items: center;

  justify-content: center;

  margin-bottom: 15px;

}


.pdf-page {

  display: block;

  max-width: 100%;

  height: auto;

  background: white;

  box-shadow:
    0 2px 12px
    rgba(0,0,0,.12);

}


.pdf-page-loading {

  width: 100%;

  min-height: 500px;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #f5f5f5;

  font-size: 14px;

  opacity: .7;

}


.pdf-page-error {

  width: 100%;

  min-height: 300px;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  gap: 15px;

}


.pdf-retry-btn {

  border: 0;

  border-radius: 8px;

  padding: 9px 16px;

  cursor: pointer;

  font-family: inherit;

  font-weight: 700;

}


@media (max-width: 760px) {

  .pdf-reader-page {

    padding: 5px;

  }


  .pdf-reader-top {

    padding: 8px;

  }


  .pdf-reader-title-box h1 {

    font-size: 17px;

  }


  .pdf-page-wrapper {

    min-height: 400px;

    margin-bottom: 8px;

  }


  .pdf-page-loading {

    min-height: 400px;

  }

}

</style>
