---
layout: base.njk
title: المقالات
description: اكتشف أحدث المقالات والموضوعات في عالم الهدى
permalink: /articles/index.html
---

<section class="section library-page premium-library">

  <!-- الواجهة الرئيسية -->
  <div class="premium-library-hero">

    <div class="premium-library-hero-content">

      <span class="premium-library-eyebrow">
        علم الهدى / المقالات
      </span>

      <h1>المقالات والمعرفة</h1>

      <p>
        اكتشف مجموعة من المقالات والموضوعات المتنوعة،
        وتصفح أحدث الأفكار والمعلومات والمحتوى
        الذي نقدمه لك في علم الهدى.
      </p>

    </div>

    <div class="premium-library-decoration" aria-hidden="true">
      <span class="premium-library-decoration-small">
        ALAMELHADA
      </span>

      <span class="premium-library-decoration-icon">✦</span>

      <span class="premium-library-decoration-text">
        ARTICLES
      </span>
    </div>

  </div>

  <!-- عنوان المقالات -->
  <div class="premium-library-toolbar">

    <div class="premium-library-toolbar-heading">
      <span>مقالات علم الهدى</span>
      <h2>جميع المقالات</h2>
    </div>

  </div>

  <!-- شبكة المقالات -->
  <div class="articles-page-grid">

    {% for post in collections.article | reverse %}

      <article class="articles-page-card">

        {% if post.data.image %}

          <a
            class="articles-page-image"
            href="{{ post.url }}"
          >

            <img
              src="{{ post.data.image | escape }}"
              alt="{{ post.data.title | escape }}"
              loading="lazy"
            >

          </a>

        {% endif %}

        <div class="articles-page-content">

          <span class="articles-page-category">
            علم الهدى / مقالات
          </span>

          <h3>
            <a href="{{ post.url }}">
              {{ post.data.title }}
            </a>
          </h3>

          <p class="articles-page-description">
            {{ (post.data.summary or post.templateContent or "") | striptags | truncate(150, true, "...") }}
          </p>

          <a
            class="articles-page-link"
            href="{{ post.url }}"
          >
            قراءة المقال
            <span aria-hidden="true">←</span>
          </a>

        </div>

      </article>

    {% else %}

      <p class="library-empty">
        لا توجد مقالات منشورة حاليًا.
      </p>

    {% endfor %}

  </div>

</section>

<style>

  /* شبكة المقالات */

  .articles-page-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 28px;
  }

  /* بطاقة المقال */

  .articles-page-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid #e6ebe7;
    border-radius: 20px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.035);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .articles-page-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.08);
  }

  /* مساحة موحدة لجميع صور المقالات */

  .articles-page-image {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 180px;
    aspect-ratio: auto;
    padding: 10px;
    margin: 0;
    box-sizing: border-box;
    overflow: hidden;
    background: #f5f6f2;
  }

  /* عرض الصورة كاملة دون قص */

  .articles-page-image img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
    transform: none;
  }

  /* منع تكبير الصورة عند مرور الماوس */

  .articles-page-card:hover .articles-page-image img {
    transform: none;
  }

  /* محتوى البطاقة */

  .articles-page-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
    padding: 26px;
    flex: 1;
  }

  .articles-page-category {
    color: #54715d;
    font-size: 12px;
    font-weight: 700;
  }

  /* عنوان المقال */

  .articles-page-content h3 {
    margin: 0;
    font-size: 21px;
    line-height: 1.6;
  }

  .articles-page-content h3 a {
    color: #20382c;
    text-decoration: none;
  }

  /* وصف مختصر من 3 أسطر */

  .articles-page-description {
    margin: 0;
    color: #647269;
    font-size: 15px;
    line-height: 1.8;

    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;

    overflow: hidden;
    overflow-wrap: anywhere;
  }

  /* زر قراءة المقال */

  .articles-page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: auto;
    padding: 12px 22px;
    border-radius: 11px;
    background: #1b342c;
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
    transition: background 0.2s ease;
  }

  .articles-page-link:hover {
    background: #315c47;
    color: #ffffff;
  }

  /* الأجهزة اللوحية */

  @media (max-width: 900px) {
    .articles-page-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  

/* عرض 3 بطاقات على الجوال */
@media (max-width: 600px) {

  .articles-page-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
  }

  .articles-page-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    border-radius: 10px;
  }

  .articles-page-image {
    width: 100%;
    height: 95px;
    padding: 4px;
    box-sizing: border-box;
  }

  .articles-page-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .articles-page-content {
    padding: 8px 5px;
    gap: 6px;
  }

  .articles-page-category {
    font-size: 9px;
  }

  .articles-page-content h3 {
    font-size: 11px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .articles-page-description {
    font-size: 10px;
    line-height: 1.5;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .articles-page-link {
    width: 100%;
    padding: 7px 3px;
    font-size: 10px;
    gap: 3px;
    box-sizing: border-box;
    text-align: center;
  }

}
