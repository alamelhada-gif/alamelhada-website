title: تفاصيل الفيلم أو المسلسل | علم الهدى
description: اكتشف الأفلام والمسلسلات على علم الهدى
permalink: /cinema-detail/index.html
---

<section class="cinema-page" dir="rtl">
  <div id="cinemaDetail">
    <p class="cinema-status">جاري تحميل التفاصيل...</p>
  </div>
</section>


<style>
.cinema-page {
  --cinema-bg: #ffffff;
  --cinema-card: #f5f7fb;
  --cinema-border: #e3e8f0;
  --cinema-text: #172033;
  --cinema-muted: #596579;
  --cinema-accent: #2563eb;

  background: var(--cinema-bg);
  color: var(--cinema-text);
  border: 1px solid var(--cinema-border);
  border-radius: 22px;
  padding: clamp(20px, 4vw, 44px);
  margin: 24px auto;
  max-width: 1120px;
  box-sizing: border-box;
}

.cinema-page * {
  box-sizing: border-box;
}

.cinema-detail {
  display: grid;
  grid-template-columns: 230px minmax(0, 1fr);
  gap: 34px;
  align-items: start;
}


.cinema-detail-poster {
  width: 100%;
  max-width: 230px;
  aspect-ratio: 2 / 3;
  object-fit: cover;
  border-radius: 16px;
  box-shadow: 0 12px 28px #18243b20;
  grid-column: 1;
  grid-row: 1;
}

.cinema-detail-info {
  grid-column: 2;
  grid-row: 1;
  min-width: 0;
}

.cinema-detail-info h1 {
  font-size: clamp(25px, 3vw, 36px);
  line-height: 1.5;
  color: var(--cinema-text);
  margin: 0 0 18px;
  overflow-wrap: anywhere;
}

.cinema-detail-info > p {
  color: var(--cinema-muted);
  font-size: 16px;
  line-height: 2;
  margin: 14px 0;
  max-width: 720px;
}

.cinema-detail-info > p:first-of-type {
  display: inline-block;
  background: #eaf1ff;
  color: #2354a0;
  padding: 5px 14px;
  border-radius: 30px;
  font-size: 13px;
  line-height: 1.8;
}

.cinema-categories {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  margin: 16px 0 22px;
}

.cinema-category-link {
  display: inline-flex;
  align-items: center;
  padding: 8px 16px;
  background: #eaf1ff;
  color: #2354a0;
  border: 1px solid #cbdcf9;
  border-radius: 999px;ب
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  transition: background .2s ease;
}

.cinema-category-link:hover {
  background: #dbeafe;
  color: #173e7a;
}

.cinema-type {
  display: inline-block;
  background: #eaf1ff;
  color: #2354a0;
  padding: 6px 14px;
  border-radius: 30px;
  font-size: 13px;
}

.cinema-download {
  display: inline-block;
  background: #eef2f8;
  color: #4b5870;
  padding: 12px 18px;
  border-radius: 12px;
  margin-top: 20px;
  font-size: 14px;
}

.cinema-seasons {
  margin-top: 35px;
  padding-top: 25px;
  border-top: 1px solid var(--cinema-border);
}

.cinema-seasons-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
  margin-bottom: 22px;
}

.cinema-seasons-header h2,
.cinema-season > h2 {
  color: var(--cinema-text);
  font-size: 22px;
  margin: 0 0 14px;
}

.cinema-season-select {
  background: #fff;
  color: #172033;
  border: 1px solid #cbd5e1;
  border-radius: 10px;
  padding: 11px 15px;
  min-width: 170px;
  font: inherit;
}

.cinema-episodes {
  display: grid;
  gap: 12px;
}

.cinema-episode {
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 14px;
  background: var(--cinema-card);
  border: 1px solid var(--cinema-border);
  border-radius: 12px;
}

.cinema-episode-number {
  flex: 0 0 55px;
  height: 55px;
  background: #e4ecfa;
  color: #2354a0;
  border-radius: 10px;
  display: flex;
  justify-content: center;
  align-items: center;
  font-weight: bold;
  font-size: 19px;
}

.cinema-episode-content {
  flex: 1;
  min-width: 0;
}

.cinema-episode h3 {
  font-size: 16px;
  color: var(--cinema-text);
  margin: 0 0 5px;
}

.cinema-episode p {
  color: var(--cinema-muted);
  line-height: 1.8;
  margin: 0;
  font-size: 14px;
}

.cinema-season[hidden] {
  display: none !important;
}

@media (max-width: 650px) {
  .cinema-page {
    padding: 18px;
    border-radius: 16px;
  }

  .cinema-detail {
    grid-template-columns: 1fr;
    gap: 22px;
  }

  .cinema-detail-poster {
    grid-column: 1;
    grid-row: 1;
    max-width: 190px;
    margin: 0 auto;
  }

  .cinema-detail-info {
    grid-column: 1;
    grid-row: 2;
  }

  .cinema-detail-info h1 {
    font-size: 25px;
  }
}
</style>


<script>
(async function () {
  const container = document.getElementById("cinemaDetail");
  const api = "https://cinema-api.alamelhada.workers.dev";

const categoryNames = {
  arabic_movies: "أفلام عربية",
  foreign_movies: "أفلام أجنبية",
  arabic_series: "مسلسلات عربية",
  foreign_series: "مسلسلات أجنبية",
  korean_series: "مسلسلات كورية"
};

function addCategoryLink(info, item) {
  if (!item || !item.category) return;

  const type = item.kind === "series" ? "series" : "movies";

  const wrapper = document.createElement("div");
  wrapper.className = "cinema-categories";

  const link = document.createElement("a");
  link.className = "cinema-category-link";

  link.href = "/" + type + "/?category=" +
    encodeURIComponent(item.category);

  link.textContent =
    categoryNames[item.category] || item.category;

  wrapper.appendChild(link);

  const heading = info.querySelector("h1");

  if (heading) {
    heading.after(wrapper);
  } else {
    info.prepend(wrapper);
  }
}

  const params = new URLSearchParams(location.search);
  const parts = location.pathname.split("/").filter(Boolean);

  const id = params.get("id") ||
    (["movies", "series"].includes(parts[0]) ? parts[1] : null);

  // تنسيق الحلقات التي أنشأها Worker مسبقًا
  function enhanceSeasons() {
    const sections = Array.from(
      container.querySelectorAll(".cinema-season")
    );

    if (!sections.length) return false;

    const oldControls = container.querySelector(".cinema-seasons-header");
    if (oldControls) oldControls.remove();

    const header = document.createElement("div");
    header.className = "cinema-seasons-header";

    const heading = document.createElement("h2");
    heading.textContent = "المواسم والحلقات";

    const select = document.createElement("select");
    select.className = "cinema-season-select";
    select.setAttribute("aria-label", "اختيار الموسم");

    sections.forEach(function(section, index) {
      const option = document.createElement("option");
      option.value = String(index);
      option.textContent =
        section.querySelector("h2")?.textContent ||
        "الموسم " + (index + 1);

      select.appendChild(option);

      section.hidden = index !== 0;

      section.querySelectorAll(".cinema-episode").forEach(
        function(episode, episodeIndex) {
          const number = document.createElement("div");
          number.className = "cinema-episode-number";
          number.textContent = episodeIndex + 1;

          const content = document.createElement("div");
          content.className = "cinema-episode-content";

          while (episode.firstChild) {
            content.appendChild(episode.firstChild);
          }

          episode.append(number, content);
        }
      );
    });

    select.addEventListener("change", function() {
      sections.forEach(function(section, index) {
        section.hidden = index !== Number(select.value);
      });
    });

    header.append(heading, select);
    sections[0].parentNode.insertBefore(header, sections[0]);

    return true;
  }

  // في الروابط الديناميكية، Worker يوفر HTML جاهزًا للفهرسة
  
if (container.querySelector(".cinema-detail")) {
  enhanceSeasons();

  const info = container.querySelector(".cinema-detail-info");

  if (info && !info.querySelector(".cinema-categories")) {
    try {
      const response = await fetch(api + "/content");

      if (!response.ok) throw new Error("Content API error");

      const items = await response.json();

      const item = items.find(x => {
        const currentPath = decodeURIComponent(location.pathname);

        return (
          String(x.id) === id ||
          currentPath.includes(
            "/" + String(x.id) + "/"
          ) ||
          window.__CINEMA_CONTENT__?.id === x.id
        );
      });

      if (item) {
        addCategoryLink(info, item);
      }
    } catch (error) {
      console.error("Category loading:", error);
    }
  }

  return;
}


  if (!id) {
    container.textContent = "لم يتم تحديد الفيلم أو المسلسل";
    return;
  }

  try {
    const response = await fetch(api + "/content");
    if (!response.ok) throw new Error("Content API error");

    const items = await response.json();
    if (!Array.isArray(items)) throw new Error("Invalid content");

    const item = items.find(x => String(x.id) === id);

    if (!item) {
      container.textContent = "المحتوى غير موجود";
      return;
    }

    const detail = document.createElement("article");
    detail.className = "cinema-detail";

    if (item.poster) {
      const poster = document.createElement("img");
      poster.className = "cinema-detail-poster";
      poster.src = item.poster;
      poster.alt = item.title || "";
      detail.appendChild(poster);
    }

    const info = document.createElement("div");
    info.className = "cinema-detail-info";

    const title = document.createElement("h1");
    title.textContent = item.title || "بدون عنوان";

    const type = document.createElement("span");
    type.className = "cinema-type";
    type.textContent = item.kind === "series" ? "مسلسل" : "فيلم";

    const description = document.createElement("p");
    description.textContent = item.description || "لا يوجد وصف حاليًا";

    const download = document.createElement("span");
    download.className = "cinema-download";
    download.textContent = "تطبيق المشاهدة قريبًا على Google Play";

    info.append(title, type, description, download);
    addCategoryLink(info, item);
    detail.appendChild(info);
    container.replaceChildren(detail);

    if (item.kind !== "series") return;

    const seasonsResponse = await fetch(
      api + "/seasons?seriesId=" + encodeURIComponent(id)
    );

    if (!seasonsResponse.ok) throw new Error("Seasons API error");

    const seasons = await seasonsResponse.json();
    if (!Array.isArray(seasons)) throw new Error("Invalid seasons");

    const seasonsContainer = document.createElement("div");
    seasonsContainer.className = "cinema-seasons";

    for (const season of seasons) {
      const section = document.createElement("section");
      section.className = "cinema-season";

      const seasonTitle = document.createElement("h2");
      seasonTitle.textContent = season.title ||
        "الموسم " + (season.season_number || 1);
      section.appendChild(seasonTitle);

      const episodesResponse = await fetch(
        api + "/episodes?seasonId=" + encodeURIComponent(season.id)
      );

      if (!episodesResponse.ok) throw new Error("Episodes API error");

      const episodes = await episodesResponse.json();
      if (!Array.isArray(episodes)) throw new Error("Invalid episodes");

      episodes.sort((a, b) =>
        Number(a.episodeNumber || 0) - Number(b.episodeNumber || 0)
      );

      const list = document.createElement("div");
      list.className = "cinema-episodes";

      for (const episode of episodes) {
        const card = document.createElement("article");
        card.className = "cinema-episode";

        const heading = document.createElement("h3");
        heading.textContent = episode.title ||
          "الحلقة " + episode.episodeNumber;

        card.appendChild(heading);

        if (episode.description) {
          const desc = document.createElement("p");
          desc.textContent = episode.description;
          card.appendChild(desc);
        }

        list.appendChild(card);
      }

      section.appendChild(list);
      seasonsContainer.appendChild(section);
    }

    info.appendChild(seasonsContainer);
    enhanceSeasons();

  } catch (error) {
    console.error("Cinema detail:", error);

    if (!container.querySelector(".cinema-detail")) {
      container.textContent = "تعذر تحميل التفاصيل حاليًا";
    }
  }
})();
</script>
