---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for page in collections.all %}
  {%- if page.url %}
  <url>
    <loc>https://alamelhada.com{{ page.url | url }}</loc>
  </url>
  {%- endif %}
{%- endfor %}

{%- for book in libraryCatalog.books %}
  {%- set slug = book.title | slugify %}
  <url>
    <loc>https://alamelhada.com/books/{{ slug }}/</loc>
  </url>
{%- endfor %}

{%- for novel in libraryCatalog.novels %}
  {%- set slug = novel.title | slugify %}
  <url>
    <loc>https://alamelhada.com/novels/{{ slug }}/</loc>
  </url>
{%- endfor %}
</urlset>
