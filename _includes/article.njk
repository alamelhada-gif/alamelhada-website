<!doctype html>
<html lang="{{ lang or 'ar' }}" dir="{% if lang == 'en' %}ltr{% else %}rtl{% endif %}">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ title }} | {{ site.name }}</title>
  <meta name="description" content="{{ summary or site.tagline_ar }}">

  <link rel="icon" href="/favicon.svg">
  <link rel="stylesheet" href="/assets/css/style.css">

  <style>
    body {
      margin: 0;
      background: #f7f7f5;
    }

    .article-page {
      width: min(920px, calc(100% - 40px));
      margin: 0 auto;
      padding: 60px 0 100px;
    }

    .article-back {
      display: inline-flex;
      align-items: center;
      margin-bottom: 35px;
      color: var(--primary);
      font-weight: 700;
      text-decoration: none;
    }

    .article-header {
      text-align: center;
      max-width: 800px;
      margin: 0 auto 40px;
    }

    .article-header h1 {
      margin: 0 0 20px;
      color: var(--dark);
      font-size: clamp(2.2rem, 6vw, 4rem);
      line-height: 1.25;
    }

    .article-summary {
      margin: 0 auto 15px;
      max-width: 720px;
      font-size: 1.15rem;
      line-height: 1.9;
      opacity: 0.75;
    }

    .article-date {
      font-size: 0.9rem;
      opacity: 0.55;
    }

    .article-cover {
      width: 100%;
      margin: 0 0 35px;
      overflow: hidden;
      border-radius: 26px;
      background: #eee;
      box-shadow: 0 15px 45px rgba(0, 0, 0, 0.08);
    }

    .article-cover img {
      display: block;
      width: 100%;
      max-height: 520px;
      object-fit: cover;
    }

    .article-content {
      background: #fff;
      padding: clamp(28px, 6vw, 60px);
      border-radius: 26px;
      box-shadow: 0 15px 50px rgba(0, 0, 0, 0.07);

      font-size: 1.08rem;
      line-height: 2.1;
      color: #222;
    }

    .article-content h1,
    .article-content h2,
    .article-content h3 {
      color: var(--dark);
      line-height: 1.4;
      margin-top: 1.8em;
      margin-bottom: 0.7em;
    }

    .article-content p {
      margin: 0 0 1.4em;
    }

    .article-content ul,
    .article-content ol {
      padding-inline-start: 28px;
      margin-bottom: 1.5em;
    }

    .article-content li {
      margin-bottom: 8px;
    }

    .article-content img {
      display: block;
      max-width: 100%;
      height: auto;
      margin: 35px auto;
      border-radius: 18px;
    }

    .article-content a {
      color: var(--primary);
      word-break: break-word;
    }

    .article-content blockquote {
      margin: 30px 0;
      padding: 20px 25px;
      border-inline-start: 4px solid var(--primary);
      background: #f6f6f4;
      border-radius: 12px;
    }

    @media (max-width: 650px) {
      .article-page {
        width: min(100% - 28px, 920px);
        padding: 35px 0 70px;
      }

      .article-header {
        margin-bottom: 28px;
      }

      .article-cover,
      .article-content {
        border-radius: 18px;
      }

      .article-content {
        padding: 25px 20px;
      }
    }
  </style>
</head>

<body style="--primary:{{ site.primary }}; --accent:{{ site.accent }}; --dark:{{ site.dark }}; --light:{{ site.light }};">

<header>
  <a class="brand" href="/">{{ site.name }}</a>

  <nav>
    <a href="/#apps">
      {% if lang == 'en' %}Apps{% else %}التطبيقات{% endif %}
    </a>

    <a href="/articles/">
      {% if lang == 'en' %}Articles{% else %}المقالات{% endif %}
    </a>

    <a href="/about/">
      {% if lang == 'en' %}About{% else %}من نحن{% endif %}
    </a>

    <a href="/contact/">
      {% if lang == 'en' %}Contact{% else %}تواصل{% endif %}
    </a>
  </nav>
</header>

<main class="article-page">

  <a class="article-back" href="/articles/">
    {% if lang == 'en' %}
      ← Back to articles
    {% else %}
      العودة إلى المقالات ←
    {% endif %}
  </a>

  <article>

    <div class="article-header">

      <h1>{{ title }}</h1>

      {% if summary %}
        <p class="article-summary">
          {{ summary }}
        </p>
      {% endif %}

      {% if date %}
        <div class="article-date">
          {{ date }}
        </div>
      {% endif %}

    </div>

    {% if image %}
      <div class="article-cover">
        <img
          src="{{ image }}"
          alt="{{ title }}"
          loading="eager"
        >
      </div>
    {% endif %}

    <div class="article-content">
      {{ content | safe }}
    </div>

  </article>

</main>

<footer>
  <strong>{{ site.name }}</strong>
  <span>© 2026</span>

  <a href="/privacy/">
    {% if lang == 'en' %}
      Privacy Policy
    {% else %}
      سياسة الخصوصية
    {% endif %}
  </a>
</footer>

</body>
</html>
