
<!doctype html>
<html lang="{{ lang or 'ar' }}" dir="{% if lang == 'en' %}ltr{% else %}rtl{% endif %}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">

  {# ========================= #}
  {# إعدادات SEO               #}
  {# ========================= #}

  {% set seoTitle = title or site.seo_title or site.name %}
  {% set seoDescription = description or summary or site.seo_description or site.tagline_ar %}
  {% set seoOgTitle = title or site.seo_og_title or site.seo_title or site.name %}
  {% set seoOgDescription = description or summary or site.seo_og_description or site.seo_description or site.tagline_ar %}

  {% set seoCanonical = "https://alamelhada.com" + (page.url or "/") %}

  {% if page.url == "/" and site.seo_canonical %}
    {% set seoCanonical = site.seo_canonical %}
  {% endif %}

  {% set seoImage = site.seo_image %}

  {% if seoImage and seoImage.startsWith("/") %}
    {% set seoImage = "https://alamelhada.com" + seoImage %}
  {% endif %}

  <meta name="theme-color" content="{{ site.dark | escape }}">

  <title>{{ seoTitle | escape }}</title>

  <meta name="description" content="{{ seoDescription | striptags | escape }}">

  {% if site.seo_keywords %}
    <meta name="keywords" content="{{ site.seo_keywords | escape }}">
  {% endif %}

  {% if site.seo_index == false %}
    <meta name="robots" content="noindex, nofollow">
  {% else %}
    <meta name="robots" content="index, follow">
  {% endif %}

  <link rel="canonical" href="{{ seoCanonical | escape }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name | escape }}">
  <meta property="og:title" content="{{ seoOgTitle | escape }}">
  <meta property="og:description" content="{{ seoOgDescription | striptags | escape }}">
  <meta property="og:url" content="{{ seoCanonical | escape }}">

  {% if seoImage %}
    <meta property="og:image" content="{{ seoImage | escape }}">
  {% endif %}

  <meta name="twitter:card" content="{% if seoImage %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{{ seoOgTitle | escape }}">
  <meta name="twitter:description" content="{{ seoOgDescription | striptags | escape }}">

  {% if seoImage %}
    <meta name="twitter:image" content="{{ seoImage | escape }}">
  {% endif %}

  {# بيانات منظمة لتعريف الموقع #}
  {% set schemaData = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://alamelhada.com/#website",
    "url": "https://alamelhada.com/",
    "name": site.name or "Alam Elhada",
    "description": seoDescription | striptags,
    "inLanguage": lang or "ar"
  } %}

  <script type="application/ld+json">
    {{ schemaData | dump | safe }}
  </script>


  <link rel="icon" href="/favicon.svg">

  <!-- CSS الأساسي -->
  <link rel="stylesheet" href="/assets/css/style.css">

  <!-- اختيار الثيم -->
  {% set activeTheme = appearance.active_theme or "classic" %}

  {% if activeTheme == "signature" %}
    <link rel="stylesheet" href="/assets/css/themes/signature.css">
    
{% elif activeTheme == "studio" %}
  <link rel="preload" href="/assets/css/themes/studio.css" as="style">
  <link rel="stylesheet" href="/assets/css/themes/studio.css">
  {% elif activeTheme == "noir" %}
    <link rel="stylesheet" href="/assets/css/themes/noir.css">
  {% endif %}

</head>

<body
  class="theme-{{ activeTheme }}"
  style="{% if activeTheme == 'classic' %}--primary:{{ site.primary }};--accent:{{ site.accent }};--dark:{{ site.dark }};--light:{{ site.light }};{% elif appearance.custom_colors and (activeTheme == 'signature' or activeTheme == 'studio' or activeTheme == 'noir') %}--primary:{{ appearance.primary_color }};--accent:{{ appearance.accent_color }};{% endif %}"
>

<!-- ====================================== -->
<!-- الهيدر                                 -->
<!-- ====================================== -->

<header class="site-header">

  <!-- الشعار -->
  <a class="brand" href="/">
    {% if site.logo %}
      <img
        src="{{ site.logo }}"
        alt="{{ site.name }}"
        style="max-height:48px;max-width:180px;object-fit:contain;"
      >
    {% else %}
      {{ site.name }}
    {% endif %}
  </a>

  <!-- ====================================== -->
  <!-- قائمة الكمبيوتر                        -->
  <!-- ====================================== -->

  <nav class="site-nav" aria-label="{% if lang == 'en' %}Main navigation{% else %}القائمة الرئيسية{% endif %}">

    <!-- الكتب -->
    <a href="/books/">
      {% if lang == 'en' %}
        Books
      {% else %}
        الكتب
      {% endif %}
    </a>

    <!-- الروايات -->
    <a href="/novels/">
      {% if lang == 'en' %}
        Novels
      {% else %}
        الروايات
      {% endif %}
    </a>

    <!-- التطبيقات -->
    {% if site.show_nav_apps %}
      <a href="/apps/">
        {% if lang == 'en' %}
          {{ site.nav_apps_en }}
        {% else %}
          {{ site.nav_apps }}
        {% endif %}
      </a>
    {% endif %}

    <!-- المقالات -->
    {% if site.show_nav_articles %}
      <a href="/articles/">
        {% if lang == 'en' %}
          {{ site.nav_articles_en }}
        {% else %}
          {{ site.nav_articles }}
        {% endif %}
      </a>
    {% endif %}

    <!-- من نحن -->
    {% if site.show_nav_about %}
      <a href="/about/">
        {% if lang == 'en' %}
          {{ site.nav_about_en }}
        {% else %}
          {{ site.nav_about }}
        {% endif %}
      </a>
    {% endif %}

    <!-- التواصل -->
    {% if site.show_nav_contact %}
      <a href="/contact/">
        {% if lang == 'en' %}
          {{ site.nav_contact_en }}
        {% else %}
          {{ site.nav_contact }}
        {% endif %}
      </a>
    {% endif %}

  </nav>

  <!-- ====================================== -->
  <!-- زر القائمة للجوال                     -->
  <!-- ====================================== -->

  <button
    class="mobile-menu-btn"
    type="button"
    aria-label="{% if lang == 'en' %}Open menu{% else %}فتح القائمة{% endif %}"
    aria-controls="site-mobile-menu"
    aria-expanded="false"
    onclick="document.body.classList.add('mobile-menu-open');this.setAttribute('aria-expanded','true')"
  >
    ☰
  </button>

  <!-- خلفية القائمة -->
  <div
    class="mobile-menu-overlay"
    onclick="document.body.classList.remove('mobile-menu-open');document.querySelector('.mobile-menu-btn').setAttribute('aria-expanded','false')"
  ></div>

  <!-- ====================================== -->
  <!-- القائمة الجانبية للجوال                -->
  <!-- ====================================== -->

  <aside class="mobile-menu" id="site-mobile-menu" aria-label="{% if lang == 'en' %}Mobile navigation{% else %}قائمة الجوال{% endif %}">

    <button
      class="mobile-menu-close"
      type="button"
      aria-label="{% if lang == 'en' %}Close menu{% else %}إغلاق القائمة{% endif %}"
      onclick="document.body.classList.remove('mobile-menu-open');document.querySelector('.mobile-menu-btn').setAttribute('aria-expanded','false')"
    >
      ×
    </button>

    <div class="mobile-menu-links">

      <!-- الكتب -->
      <a
        href="/books/"
        onclick="document.body.classList.remove('mobile-menu-open')"
      >
        {% if lang == 'en' %}
          Books
        {% else %}
          الكتب
        {% endif %}
      </a>

      <!-- الروايات -->
      <a
        href="/novels/"
        onclick="document.body.classList.remove('mobile-menu-open')"
      >
        {% if lang == 'en' %}
          Novels
        {% else %}
          الروايات
        {% endif %}
      </a>

      <!-- التطبيقات -->
      {% if site.show_nav_apps %}
        <a
          href="/apps/"
          onclick="document.body.classList.remove('mobile-menu-open')"
        >
          {% if lang == 'en' %}
            {{ site.nav_apps_en }}
          {% else %}
            {{ site.nav_apps }}
          {% endif %}
        </a>
      {% endif %}

      <!-- المقالات -->
      {% if site.show_nav_articles %}
        <a
          href="/articles/"
          onclick="document.body.classList.remove('mobile-menu-open')"
        >
          {% if lang == 'en' %}
            {{ site.nav_articles_en }}
          {% else %}
            {{ site.nav_articles }}
          {% endif %}
        </a>
      {% endif %}

      <!-- من نحن -->
      {% if site.show_nav_about %}
        <a
          href="/about/"
          onclick="document.body.classList.remove('mobile-menu-open')"
        >
          {% if lang == 'en' %}
            {{ site.nav_about_en }}
          {% else %}
            {{ site.nav_about }}
          {% endif %}
        </a>
      {% endif %}

      <!-- التواصل -->
      {% if site.show_nav_contact %}
        <a
          href="/contact/"
          onclick="document.body.classList.remove('mobile-menu-open')"
        >
          {% if lang == 'en' %}
            {{ site.nav_contact_en }}
          {% else %}
            {{ site.nav_contact }}
          {% endif %}
        </a>
      {% endif %}

    </div>

  </aside>

</header>

<!-- ====================================== -->
<!-- محتوى الصفحات                          -->
<!-- ====================================== -->

<main class="site-main">
  {{ content | safe }}
</main>

<!-- ====================================== -->
<!-- الفوتر                                 -->
<!-- ====================================== -->

<footer class="site-footer">

  <strong>
    {{ site.footer_name or site.name }}
  </strong>

  <span>
    © {{ site.footer_year }}
  </span>

  <a href="/privacy/">
    {% if lang == 'en' %}
      {{ site.privacy_text_en }}
    {% else %}
      {{ site.privacy_text }}
    {% endif %}
  </a>

  {% if site.email %}
    <a href="mailto:{{ site.email }}">
      {{ site.email }}
    </a>
  {% endif %}

</footer>

</body>
</html>
