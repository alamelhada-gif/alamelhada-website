<!doctype html>
<html lang="{{ lang or 'ar' }}" dir="{% if lang == 'en' %}ltr{% else %}rtl{% endif %}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">

  <meta name="theme-color" content="{{ site.dark }}">

  <title>{{ title or site.seo_title or site.name }}</title>

  <meta
    name="description"
    content="{{ description or summary or site.seo_description or site.tagline_ar }}"
  >

  {% if site.seo_image %}
    <meta property="og:image" content="{{ site.seo_image }}">
  {% endif %}

  <meta
    property="og:title"
    content="{{ title or site.seo_title or site.name }}"
  >

  <meta
    property="og:description"
    content="{{ description or summary or site.seo_description or site.tagline_ar }}"
  >

  <link rel="icon" href="/favicon.svg">
  <link rel="stylesheet" href="/assets/css/style.css">

  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>

<body style="--primary:{{site.primary}};--accent:{{site.accent}};--dark:{{site.dark}};--light:{{site.light}}">

<header>

  <a class="brand" href="/">

    {% if site.logo %}
      <img
        src="{{ site.logo }}"
        alt="{{ site.name }}"
        style="max-height:48px;max-width:180px;object-fit:contain;"
      >
    {% else %}
      {{ site.name }}
    {% endif %}

  </a>


  <nav>

    {# ========================= #}
    {# الكتب                     #}
    {# ========================= #}

    <a href="/books/">
      {% if lang == 'en' %}
        Books
      {% else %}
        الكتب
      {% endif %}
    </a>


    {# ========================= #}
    {# الروايات                  #}
    {# ========================= #}

    <a href="/novels/">
      {% if lang == 'en' %}
        Novels
      {% else %}
        الروايات
      {% endif %}
    </a>


    {# ========================= #}
    {# التطبيقات                 #}
    {# ========================= #}

    {% if site.show_nav_apps %}
      <a href="/#apps">
        {% if lang == 'en' %}
          {{ site.nav_apps_en }}
        {% else %}
          {{ site.nav_apps }}
        {% endif %}
      </a>
    {% endif %}


    {# ========================= #}
    {# المقالات                  #}
    {# ========================= #}

    {% if site.show_nav_articles %}
      <a href="/articles/">
        {% if lang == 'en' %}
          {{ site.nav_articles_en }}
        {% else %}
          {{ site.nav_articles }}
        {% endif %}
      </a>
    {% endif %}


    {# ========================= #}
    {# من نحن                    #}
    {# ========================= #}

    {% if site.show_nav_about %}
      <a href="/about/">
        {% if lang == 'en' %}
          {{ site.nav_about_en }}
        {% else %}
          {{ site.nav_about }}
        {% endif %}
      </a>
    {% endif %}


    {# ========================= #}
    {# التواصل                   #}
    {# ========================= #}

    {% if site.show_nav_contact %}
      <a href="/contact/">
        {% if lang == 'en' %}
          {{ site.nav_contact_en }}
        {% else %}
          {{ site.nav_contact }}
        {% endif %}
      </a>
    {% endif %}

  </nav>

</header>


<main>
  {{ content | safe }}
</main>


<footer>

  <strong>
    {{ site.footer_name or site.name }}
  </strong>

  <span>
    © {{ site.footer_year }}
  </span>

  <a href="/privacy/">
    {% if lang == 'en' %}
      {{ site.privacy_text_en }}
    {% else %}
      {{ site.privacy_text }}
    {% endif %}
  </a>

  {% if site.email %}
    <a href="mailto:{{ site.email }}">
      {{ site.email }}
    </a>
  {% endif %}

</footer>

</body>
</html>
