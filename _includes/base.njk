<!doctype html>
<html lang="{{ lang or 'ar' }}" dir="{% if lang == 'en' %}ltr{% else %}rtl{% endif %}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ site.dark }}">

  <title>{{ title or site.name }}</title>
  <meta name="description" content="{{ description or summary or site.tagline_ar }}">

  <link rel="icon" href="/favicon.svg">
  <link rel="stylesheet" href="/assets/css/style.css">

  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>

<body style="--primary:{{site.primary}};--accent:{{site.accent}};--dark:{{site.dark}};--light:{{site.light}}">

<header>
  <a class="brand" href="/">{{site.name}}</a>

  <nav>
    <a href="/#apps">
      {% if lang == 'en' %}Apps{% else %}التطبيقات{% endif %}
    </a>

    <a href="/articles/">
      {% if lang == 'en' %}Articles{% else %}المقالات{% endif %}
    </a>

    <a href="/about/">
      {% if lang == 'en' %}About{% else %}من نحن{% endif %}
    </a>

    <a href="/contact/">
      {% if lang == 'en' %}Contact{% else %}تواصل{% endif %}
    </a>
  </nav>
</header>

<main>
  {{ content | safe }}
</main>

<footer>
  <strong>{{site.name}}</strong>
  <span>© 2026</span>

  <a href="/privacy/">
    {% if lang == 'en' %}
      Privacy Policy
    {% else %}
      سياسة الخصوصية
    {% endif %}
  </a>
</footer>

</body>
</html>
