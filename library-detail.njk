<style>
/* تصميم صفحة تفاصيل الكتب والروايات */
#dynamicLibraryDetail {
  width: 100%;
  max-width: 1000px;
  margin: 0 auto;
  padding: 24px 16px 45px;
  text-align: center;
  direction: rtl;
}

/* إزالة شكل البطاقة والخلفية الرمادية */
#dynamicLibraryDetail > .library-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  width: 100%;
  max-width: 850px;
  margin: 0 auto;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
  overflow: visible;
}

/* ترتيب العنوان فوق الغلاف */
#dynamicLibraryDetail > .library-card .library-card-content {
  display: contents;
}

#dynamicLibraryDetail > .library-card h1 {
  order: 1;
  width: 100%;
  margin: 0 0 12px;
  font-size: clamp(26px, 5vw, 38px);
  font-weight: 800;
  line-height: 1.5;
  color: #111827;
}

/* الغلاف */
#dynamicLibraryDetail > .library-card .library-cover {
  order: 2;
  display: flex;
  justify-content: center;
  align-items: center;
  width: auto;
  height: auto;
  min-height: 0;
  margin: 0 auto;
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
}

#dynamicLibraryDetail > .library-card .library-cover img {
  display: block;
  width: auto;
  max-width: min(230px, 65vw);
  height: auto;
  max-height: 340px;
  object-fit: contain;
  margin: 0 auto;
  border-radius: 6px;
}

/* المؤلف والتصنيف */
#dynamicLibraryDetail > .library-card .library-author,
#dynamicLibraryDetail > .library-card .library-card-content > p:not(.library-description) {
  order: 3;
  margin: 0;
  font-size: 14px;
  color: #64748b;
}

/* الوصف */
#dynamicLibraryDetail > .library-card .library-description {
  order: 4;
  width: 100%;
  max-width: 760px;
  margin: 12px auto;
  font-size: 16px;
  line-height: 2;
