#dynamicLibraryDetail > .library-card .library-read-btn {
  order: 5;
  display: inline-block;
  width: auto;
  margin: 8px auto 0;
  padding: 12px 28px;
  background: #4F9A43;
  color: #fff;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 700;
}

#dynamicLibraryDetail > .library-card .library-read-btn:hover {
  background: #3f8035;
}

/* قسم اقرأ أيضًا */
#relatedLibraryItems {
  width: 100%;
  margin: 45px auto 0 !important;
  text-align: right;
}

#relatedLibraryItems h2 {
  margin-bottom: 20px;
  font-size: 22px;
}

@media (max-width: 600px) {
  #dynamicLibraryDetail {
