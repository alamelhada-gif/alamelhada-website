---
layout: base.njk
title: Alamelhada Apps
---

<section class="hero">
  <div>
    <span class="eyebrow">{{ site.hero_eyebrow }}</span>

    <h1>
      {{ site.hero_title_line1 }}<br>
      <em>{{ site.hero_title_line2 }}</em>
    </h1>

    <p>{{ site.tagline_ar }}</p>

    <div class="actions">

      {% if site.show_apps != false %}
        <a class="btn" href="#apps">
          {{ site.hero_primary_button }}
        </a>
      {% endif %}

      {% if site.show_articles != false %}
        <a class="ghost" href="/articles/">
          {{ site.hero_secondary_button }}
        </a>
      {% endif %}

    </div>
  </div>

  <div class="mark">A</div>
</section>


{# ========================================= #}
{# السلايدر                                  #}
{# ========================================= #}

{% if site.show_slider != false and site.slider_items %}

<section class="home-slider-section">

  {% if site.slider_title %}
    <div class="slider-heading">
      <span>{{ site.slider_label }}</span>
      <h2>{{ site.slider_title }}</h2>
    </div>
  {% endif %}

  <div class="home-slider" id="homeSlider">

    <div class="slider-track" id="sliderTrack">

      {% for slide in site.slider_items %}

        <div class="slide">

          {% if slide.url %}
            <a
              href="{{ slide.url }}"
              {% if slide.new_tab %}
                target="_blank"
                rel="noopener"
              {% endif %}
            >
          {% endif %}

          <div class="slide-image">

            <img
              src="{{ slide.image }}"
              alt="{{ slide.title or 'Alamelhada' }}"
              loading="{% if loop.first %}eager{% else %}lazy{% endif %}"
            >

            {% if slide.title or slide.description %}
              <div class="slide-content">

                {% if slide.title %}
                  <h2>{{ slide.title }}</h2>
                {% endif %}

                {% if slide.description %}
                  <p>{{ slide.description }}</p>
                {% endif %}

              </div>
            {% endif %}

          </div>

          {% if slide.url %}
            </a>
          {% endif %}

        </div>

      {% endfor %}

    </div>


    {% if site.slider_items | length > 1 %}

      <button
        class="slider-arrow slider-prev"
        id="sliderPrev"
        type="button"
        aria-label="الصورة السابقة"
      >
        ‹
      </button>

      <button
        class="slider-arrow slider-next"
        id="sliderNext"
        type="button"
        aria-label="الصورة التالية"
      >
        ›
      </button>

      <div class="slider-dots" id="sliderDots">

        {% for slide in site.slider_items %}

          <button
            type="button"
            class="slider-dot {% if loop.first %}active{% endif %}"
            data-slide="{{ loop.index0 }}"
            aria-label="الصورة {{ loop.index }}"
          ></button>

        {% endfor %}

      </div>

    {% endif %}

  </div>

</section>

{% endif %}


{# ========================================= #}
{# التطبيقات                                 #}
{# ========================================= #}

{% if site.show_apps != false %}

<section class="section" id="apps">

  <div class="section-head">
    <span>{{ site.apps_section_label }}</span>
    <h2>{{ site.apps_section_title }}</h2>
  </div>

  <div class="cards">

    {% for app in apps.items %}

      <article class="card">

        {% if app.icon %}
          <div class="appicon">
            <img
              src="{{ app.icon }}"
              alt="{{ app.name }}"
              loading="lazy"
            >
          </div>
        {% endif %}

        <h3>{{ app.name }}</h3>

        <p>{{ app.description }}</p>

        {% if app.url %}
          <a
            href="{{ app.url }}"
            target="_blank"
            rel="noopener"
          >
            عرض على Google Play ←
          </a>
        {% endif %}

      </article>

    {% endfor %}

  </div>

</section>

{% endif %}


{# ========================================= #}
{# القسم الأسود                              #}
{# ========================================= #}

{% if site.show_statement != false %}

<section class="statement">

  <p>{{ site.statement_small }}</p>

  <h2>
    {{ site.statement_title }}
  </h2>

</section>

{% endif %}


{# ========================================= #}
{# المقالات                                  #}
{# ========================================= #}

{% if site.show_articles != false %}

<section class="section">

  <div class="section-head">

    <span>
      {{ site.articles_section_label }}
    </span>

    <h2>
      {{ site.articles_section_title }}
    </h2>

  </div>

  <div class="articles">

    {% for post in collections.article | reverse %}

      {% if loop.index <= 3 %}

        <a
          class="article"
          href="{{ post.url }}"
        >

          <h3>
            {{ post.data.title }}
          </h3>

          <p>
            {{ post.data.summary }}
          </p>

        </a>

      {% endif %}

    {% else %}

      <p>
        ستظهر المقالات هنا بعد إضافتها من لوحة الإدارة.
      </p>

    {% endfor %}

  </div>

</section>

{% endif %}


{# ========================================= #}
{# تشغيل السلايدر                            #}
{# ========================================= #}

{% if site.show_slider != false and site.slider_items and site.slider_items | length > 1 %}

<script>
document.addEventListener("DOMContentLoaded", function () {

  const track = document.getElementById("sliderTrack");
  const slides = document.querySelectorAll("#homeSlider .slide");
  const dots = document.querySelectorAll("#sliderDots .slider-dot");
  const prev = document.getElementById("sliderPrev");
  const next = document.getElementById("sliderNext");

  if (!track || slides.length < 2) {
    return;
  }

  let current = 0;
  let timer;

  function showSlide(index) {

    if (index >= slides.length) {
      index = 0;
    }

    if (index < 0) {
      index = slides.length - 1;
    }

    current = index;

    track.style.transform =
      "translateX(" + (current * -100) + "%)";

    dots.forEach(function(dot, i) {
      dot.classList.toggle("active", i === current);
    });
  }

  function startAutoPlay() {

    clearInterval(timer);

    timer = setInterval(function() {
      showSlide(current + 1);
    }, 5000);
  }

  if (next) {
    next.addEventListener("click", function() {
      showSlide(current + 1);
      startAutoPlay();
    });
  }

  if (prev) {
    prev.addEventListener("click", function() {
      showSlide(current - 1);
      startAutoPlay();
    });
  }

  dots.forEach(function(dot) {

    dot.addEventListener("click", function() {

      const index = Number(
        this.getAttribute("data-slide")
      );

      showSlide(index);
      startAutoPlay();

    });

  });

  startAutoPlay();

});
</script>

{% endif %}
