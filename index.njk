---
layout: base.njk
title: Alamelhada Apps
---

<section class="hero">
  <div>
    <span class="eyebrow">{{ site.hero_eyebrow }}</span>

    <h1>
      {{ site.hero_title_line1 }}<br>
      <em>{{ site.hero_title_line2 }}</em>
    </h1>

    <p>{{ site.tagline_ar }}</p>

    <div class="actions">
      <a class="btn" href="#apps">{{ site.hero_primary_button }}</a>
      <a class="ghost" href="/articles/">{{ site.hero_secondary_button }}</a>
    </div>
  </div>

  <div class="mark">A</div>
</section>


<section class="section" id="apps">
  <div class="section-head">
    <span>{{ site.apps_section_label }}</span>
    <h2>{{ site.apps_section_title }}</h2>
  </div>

  <div class="cards">
    {% for app in apps.items %}
      <article class="card">
        <div class="appicon">{{ app.icon }}</div>

        <h3>{{ app.name }}</h3>

        <p>{{ app.description }}</p>

        <a href="{{ app.url }}" target="_blank" rel="noopener">
          عرض على Google Play ←
        </a>
      </article>
    {% endfor %}
  </div>
</section>


<section class="statement">
  <p>{{ site.statement_small }}</p>
  <h2>{{ site.statement_title }}</h2>
</section>


<section class="section">
  <div class="section-head">
    <span>{{ site.articles_section_label }}</span>
    <h2>{{ site.articles_section_title }}</h2>
  </div>

  <div class="articles">
    {% for post in collections.article | reverse %}
      {% if loop.index <= 3 %}
        <a class="article" href="{{ post.url }}">
          <h3>{{ post.data.title }}</h3>
          <p>{{ post.data.summary }}</p>
        </a>
      {% endif %}
    {% else %}
      <p>ستظهر المقالات هنا بعد إضافتها من لوحة الإدارة.</p>
    {% endfor %}
  </div>
</section>
