---
layout: base.njk
title: Alamelhada Apps
---

{# ========================================================= #}
{# البحث العام                                               #}
{# ========================================================= #}

<section class="site-search-section">
  <div class="site-search-box">
    <span class="site-search-label">البحث في الموقع</span>

    <div class="site-search-input-wrap">
      <input
        id="siteSearchInput"
        type="search"
        placeholder="ابحث في التطبيقات، الروايات، الكتب والمقالات..."
        autocomplete="off"
        aria-label="البحث في الموقع"
      >
    </div>

    <div
      id="siteSearchResults"
      class="site-search-results"
      hidden
    ></div>
  </div>
</section>


{# ========================================================= #}
{# الواجهة الرئيسية                                          #}
{# ========================================================= #}

<section class="hero">

  <div>
    <span class="eyebrow">
      {{ site.hero_eyebrow }}
    </span>

    <h1>
      {{ site.hero_title_line1 }}<br>
      <em>{{ site.hero_title_line2 }}</em>
    </h1>

    <p>
      {{ site.tagline_ar }}
    </p>

    <div class="actions">

      {% if site.show_apps != false %}
        <a class="btn" href="#apps">
          {{ site.hero_primary_button }}
        </a>
      {% endif %}

      {% if site.show_articles != false %}
        <a class="ghost" href="/articles/">
          {{ site.hero_secondary_button }}
        </a>
      {% endif %}

    </div>
  </div>

  <div class="mark">
    A
  </div>

</section>


{# ========================================================= #}
{# سلايدر المحتوى المميز / التطبيقات                         #}
{# ========================================================= #}

{% if site.show_slider != false %}

  {% set featuredItems = collections.featured | reverse %}

  {% if featuredItems | length > 0 %}

    <section class="home-slider-section">

      {% if site.slider_title %}

        <div class="slider-heading">

          {% if site.slider_label %}
            <span>
              {{ site.slider_label }}
            </span>
          {% endif %}

          <h2>
            {{ site.slider_title }}
          </h2>

        </div>

      {% endif %}


      <div class="icon-slider" id="homeSlider">

        {% if featuredItems | length > 1 %}

          <button
            class="icon-slider-arrow icon-slider-prev"
            id="sliderPrev"
            type="button"
            aria-label="السابق"
          >
            ‹
          </button>

        {% endif %}


        <div class="icon-slider-window">

          <div
            class="icon-slider-track"
            id="sliderTrack"
          >

            {% for item in featuredItems %}

              <div class="icon-slide">

                <a
                  class="icon-slide-link"
                  href="{{ item.url }}"
                >

                  {% if item.data.image %}

                    <div class="slider-app-icon">

                      <img
                        src="{{ item.data.image }}"
                        alt="{{ item.data.title }}"
                        loading="{% if loop.first %}eager{% else %}lazy{% endif %}"
                      >

                    </div>

                  {% endif %}


                  {% if item.data.title %}

                    <h3>
                      {{ item.data.title }}
                    </h3>

                  {% endif %}


                  <span class="slider-details">
                    عرض التفاصيل ←
                  </span>

                </a>

              </div>

            {% endfor %}

          </div>

        </div>


        {% if featuredItems | length > 1 %}

          <button
            class="icon-slider-arrow icon-slider-next"
            id="sliderNext"
            type="button"
            aria-label="التالي"
          >
            ›
          </button>

        {% endif %}

      </div>

    </section>

  {% endif %}

{% endif %}


{# ========================================================= #}
{# التطبيقات - سلايدر                                       #}
{# ========================================================= #}

{% if site.show_apps != false %}

<section class="home-slider-section" id="apps">

  <div class="slider-heading">

    <span>
      {{ site.apps_section_label }}
    </span>

    <h2>
      {{ site.apps_section_title }}
    </h2>

  </div>


  <div class="icon-slider" id="appsHomeSlider">

    {% if apps.items | length > 1 %}

      <button
        class="icon-slider-arrow icon-slider-prev"
        id="appsSliderPrev"
        type="button"
        aria-label="السابق"
      >
        ‹
      </button>

    {% endif %}


    <div class="icon-slider-window">

      <div
        class="icon-slider-track"
        id="appsSliderTrack"
      >

        {% for app in apps.items %}

          <div
            class="icon-slide site-search-local-item"
            data-search-type="تطبيق"
            data-search-title="{{ app.name | escape }}"
            data-search-description="{{ app.description | escape }}"
            data-search-url="{{ app.url | escape }}"
          >

            <a
              class="icon-slide-link"
              href="{{ app.url }}"
              target="_blank"
              rel="noopener noreferrer"
            >

              {% if app.icon %}

                <div class="slider-app-icon">

                  <img
                    src="{{ app.icon }}"
                    alt="{{ app.name }}"
                    loading="lazy"
                  >

                </div>

              {% endif %}


              <h3>
                {{ app.name }}
              </h3>


              <span class="slider-details">
                عرض التفاصيل ←
              </span>

            </a>

          </div>

        {% endfor %}

      </div>

    </div>


    {% if apps.items | length > 1 %}

      <button
        class="icon-slider-arrow icon-slider-next"
        id="appsSliderNext"
        type="button"
        aria-label="التالي"
      >
        ›
      </button>

    {% endif %}

  </div>

</section>

{% endif %}

{# ========================================================= #}
{# الروايات                                                  #}
{# ========================================================= #}

<section class="section home-library-section" id="novels">

  <div class="home-library-heading">

    <div>
      <span class="home-library-label">
        مكتبة رواياتي
      </span>

      <h2>
        أحدث الروايات
      </h2>
    </div>

    <a
      class="home-library-all"
      href="/novels/"
    >
      عرض الكل ←
    </a>

  </div>


  <div class="home-library-slider">

    <button
      class="home-library-arrow home-library-prev"
      type="button"
      data-slider-target="homeNovelsTrack"
      data-direction="prev"
      aria-label="الروايات السابقة"
    >
      ‹
    </button>


    <div
      class="home-library-track"
      id="homeNovelsTrack"
    >
      <p class="home-library-loading">
        جاري تحميل الروايات...
      </p>
    </div>


    <button
      class="home-library-arrow home-library-next"
      type="button"
      data-slider-target="homeNovelsTrack"
      data-direction="next"
      aria-label="الروايات التالية"
    >
      ›
    </button>

  </div>

</section>


{# ========================================================= #}
{# الكتب                                                     #}
{# ========================================================= #}

<section class="section home-library-section" id="books">

  <div class="home-library-heading">

    <div>
      <span class="home-library-label">
        المكتبة
      </span>

      <h2>
        أحدث الكتب
      </h2>
    </div>

    <a
      class="home-library-all"
      href="/books/"
    >
      عرض الكل ←
    </a>

  </div>


  <div class="home-library-slider">

    <button
      class="home-library-arrow home-library-prev"
      type="button"
      data-slider-target="homeBooksTrack"
      data-direction="prev"
      aria-label="الكتب السابقة"
    >
      ‹
    </button>


    <div
      class="home-library-track"
      id="homeBooksTrack"
    >
      <p class="home-library-loading">
        جاري تحميل الكتب...
      </p>
    </div>


    <button
      class="home-library-arrow home-library-next"
      type="button"
      data-slider-target="homeBooksTrack"
      data-direction="next"
      aria-label="الكتب التالية"
    >
      ›
    </button>

  </div>

</section>


{# ========================================================= #}
{# القسم الأسود                                              #}
{# ========================================================= #}

{% if site.show_statement != false %}

<section class="statement">

  <p>
    {{ site.statement_small }}
  </p>

  <h2>
    {{ site.statement_title }}
  </h2>

</section>

{% endif %}


{# ========================================================= #}
{# المقالات                                                  #}
{# ========================================================= #}

{% if site.show_articles != false %}

<section class="section" id="articles">

  <div class="home-library-heading">

    <div class="section-head">

      <span>
        {{ site.articles_section_label }}
      </span>

      <h2>
        {{ site.articles_section_title }}
      </h2>

    </div>

    <a
      class="home-library-all"
      href="/articles/"
    >
      عرض كل المقالات ←
    </a>

  </div>


  <div class="articles">

    {% for post in collections.article | reverse %}

      {% if loop.index <= 3 %}

        <a
          class="article site-search-local-item"
          href="{{ post.url }}"
          data-search-type="مقال"
          data-search-title="{{ post.data.title | escape }}"
          data-search-description="{{ post.data.summary | escape }}"
          data-search-url="{{ post.url }}"
        >

          <h3>
            {{ post.data.title }}
          </h3>

          <p>
            {{ post.data.summary }}
          </p>

        </a>

      {% endif %}

    {% else %}

      <p>
        ستظهر المقالات هنا بعد إضافتها من لوحة الإدارة.
      </p>

    {% endfor %}

  </div>

</section>

{% endif %}


{# ========================================================= #}
{# بيانات كل المقالات للبحث                                  #}
{# ========================================================= #}

<div id="siteSearchArticleData" hidden>

  {% for post in collections.article | reverse %}

    <div
      class="site-search-local-item"
      data-search-type="مقال"
      data-search-title="{{ post.data.title | escape }}"
      data-search-description="{{ post.data.summary | escape }}"
      data-search-url="{{ post.url }}"
    ></div>

  {% endfor %}

</div>


{# ========================================================= #}
{# تشغيل Firebase                                            #}
{# ========================================================= #}

<script
  type="module"
  src="/assets/js/library.js"
></script>


{# ========================================================= #}
{# JavaScript                                                #}
{# ========================================================= #}

<script>
document.addEventListener("DOMContentLoaded", function () {


  /* =======================================================
     سلايدر التطبيقات المميزة
     ======================================================= */

  const track =
    document.getElementById("sliderTrack");

  const slides =
    document.querySelectorAll(
      "#homeSlider .icon-slide"
    );

  const prev =
    document.getElementById("sliderPrev");

  const next =
    document.getElementById("sliderNext");


  if (track && slides.length > 1) {

    let current = 0;
    let timer = null;


    function getVisibleItems() {

      if (window.innerWidth <= 560) {
        return 2;
      }

      if (window.innerWidth <= 850) {
        return 3;
      }

      return 5;
    }


    function getMaxIndex() {

      return Math.max(
        0,
        slides.length - getVisibleItems()
      );
    }


    function updateSlider() {

      const visible =
        getVisibleItems();

      const itemWidth =
        100 / visible;

      slides.forEach(function(slide) {

        slide.style.flexBasis =
          itemWidth + "%";

      });


      const maxIndex =
        getMaxIndex();

      if (current > maxIndex) {
        current = maxIndex;
      }


      track.style.transform =
        "translateX(" +
        (current * itemWidth) +
        "%)";
    }


    function goNext() {

      const maxIndex =
        getMaxIndex();

      if (maxIndex === 0) {
        return;
      }

      current++;

      if (current > maxIndex) {
        current = 0;
      }

      updateSlider();
    }


    function goPrev() {

      const maxIndex =
        getMaxIndex();

      if (maxIndex === 0) {
        return;
      }

      current--;

      if (current < 0) {
        current = maxIndex;
      }

      updateSlider();
    }


    function startAutoPlay() {

      clearInterval(timer);

      timer = setInterval(
        goNext,
        3500
      );
    }


    if (next) {

      next.addEventListener(
        "click",
        function () {

          goNext();
          startAutoPlay();

        }
      );

    }


    if (prev) {

      prev.addEventListener(
        "click",
        function () {

          goPrev();
          startAutoPlay();

        }
      );

    }


    window.addEventListener(
      "resize",
      function () {

        current = 0;
        updateSlider();

      }
    );


    updateSlider();
    startAutoPlay();
  }


  /* =======================================================
     سلايدر الكتب والروايات
     ======================================================= */

  document
    .querySelectorAll(".home-library-arrow")
    .forEach(function(button) {

      button.addEventListener(
        "click",
        function() {

          const target =
            document.getElementById(
              button.dataset.sliderTarget
            );

          if (!target) {
            return;
          }


          const direction =
            button.dataset.direction;


          const amount =
            Math.max(
              220,
              target.clientWidth * 0.75
            );


          target.scrollBy({
            left:
              direction === "next"
                ? -amount
                : amount,
            behavior: "smooth"
          });

        }
      );

    });


  /* =======================================================
     إضافة التطبيقات والمقالات إلى البحث العام
     ======================================================= */

  const searchInput =
    document.getElementById(
      "siteSearchInput"
    );

  const searchResults =
    document.getElementById(
      "siteSearchResults"
    );


  function escapeSearchHtml(value) {

    const div =
      document.createElement("div");

    div.textContent =
      value || "";

    return div.innerHTML;
  }


  function normalizeSearchText(value) {

    return String(value || "")
      .toLowerCase()
      .trim();
  }


  function getLocalSearchItems() {

    const elements =
      document.querySelectorAll(
        ".site-search-local-item"
      );

    const unique =
      new Map();


    elements.forEach(function(element) {

      const title =
        element.dataset.searchTitle || "";

      const description =
        element.dataset.searchDescription || "";

      const type =
        element.dataset.searchType || "";

      const url =
        element.dataset.searchUrl || "#";


      const key =
        type + "|" + title + "|" + url;


      if (!unique.has(key)) {

        unique.set(key, {
          title,
          description,
          type,
          url
        });

      }

    });


    return [...unique.values()];
  }


  function getLocalMatches(query) {

    if (!query) {
      return [];
    }


    return getLocalSearchItems()
      .filter(function(item) {

        const text =
          normalizeSearchText(
            item.title +
            " " +
            item.description +
            " " +
            item.type
          );


        return text.includes(query);

      })
      .slice(0, 10);
  }


  function renderLocalSearchResults(query) {

    if (!searchResults) {
      return;
    }


    searchResults
      .querySelectorAll(
        ".local-search-result"
      )
      .forEach(function(element) {

        element.remove();

      });


    if (!query) {
      return;
    }


    const matches =
      getLocalMatches(query);


    matches.forEach(function(item) {

      const link =
        document.createElement("a");


      link.className =
        "site-search-result local-search-result";


      link.href =
        item.url || "#";


      if (
        item.url &&
        item.url.startsWith("http")
      ) {

        link.target = "_blank";
        link.rel =
          "noopener noreferrer";

      }


      link.innerHTML = `
        <div class="site-search-local-icon">
          ${escapeSearchHtml(
            item.type.substring(0, 1)
          )}
        </div>

        <div>
          <span>
            ${escapeSearchHtml(item.type)}
          </span>

          <strong>
            ${escapeSearchHtml(item.title)}
          </strong>

          ${
            item.description
              ? `
                <small>
                  ${escapeSearchHtml(
                    item.description
                  )}
                </small>
              `
              : ""
          }
        </div>
      `;


      searchResults.appendChild(link);

    });


    if (matches.length) {

      searchResults.hidden =
        false;

    }

  }


  if (searchInput) {

    searchInput.addEventListener(
      "input",
      function() {

        const query =
          normalizeSearchText(
            searchInput.value
          );


        /*
         ننتظر قليلًا حتى يقوم library.js
         بإضافة نتائج الكتب والروايات.
        */

        setTimeout(
          function() {

            renderLocalSearchResults(
              query
            );

          },
          30
        );

      }
    );

  }

});
</script>
