---
layout: base.njk
title: Alamelhada Apps
---

<section class="hero">
  <div>
    <span class="eyebrow">{{ site.hero_eyebrow }}</span>

    <h1>
      {{ site.hero_title_line1 }}<br>
      <em>{{ site.hero_title_line2 }}</em>
    </h1>

    <p>{{ site.tagline_ar }}</p>

    <div class="actions">

      {% if site.show_apps != false %}
        <a class="btn" href="#apps">
          {{ site.hero_primary_button }}
        </a>
      {% endif %}

      {% if site.show_articles != false %}
        <a class="ghost" href="/articles/">
          {{ site.hero_secondary_button }}
        </a>
      {% endif %}

    </div>
  </div>

  <div class="mark">A</div>
</section>


{# ========================================= #}
{# سلايدر الأيقونات                          #}
{# ========================================= #}

{% if site.show_slider != false and site.slider_items %}

<section class="home-slider-section">

  {% if site.slider_title %}
    <div class="slider-heading">
      <span>{{ site.slider_label }}</span>
      <h2>{{ site.slider_title }}</h2>
    </div>
  {% endif %}

  <div class="icon-slider" id="homeSlider">

    {% if site.slider_items | length > 1 %}
      <button
        class="icon-slider-arrow icon-slider-prev"
        id="sliderPrev"
        type="button"
        aria-label="السابق"
      >
        ‹
      </button>
    {% endif %}


    <div class="icon-slider-window">

      <div class="icon-slider-track" id="sliderTrack">

        {% for slide in site.slider_items %}

          <div class="icon-slide">

            {% if slide.url %}
              <a
                class="icon-slide-link"
                href="{{ slide.url }}"
                {% if slide.new_tab %}
                  target="_blank"
                  rel="noopener"
                {% endif %}
              >
            {% else %}
              <div class="icon-slide-link">
            {% endif %}


              <div class="slider-app-icon">

                {% if slide.image %}
                  <img
                    src="{{ slide.image }}"
                    alt="{{ slide.title or 'تطبيق' }}"
                    loading="{% if loop.first %}eager{% else %}lazy{% endif %}"
                  >
                {% endif %}

              </div>


              {% if slide.title %}
                <h3>{{ slide.title }}</h3>
              {% endif %}


              {% if slide.description %}
                <p>{{ slide.description }}</p>
              {% endif %}


            {% if slide.url %}
              </a>
            {% else %}
              </div>
            {% endif %}

          </div>

        {% endfor %}

      </div>

    </div>


    {% if site.slider_items | length > 1 %}
      <button
        class="icon-slider-arrow icon-slider-next"
        id="sliderNext"
        type="button"
        aria-label="التالي"
      >
        ›
      </button>
    {% endif %}

  </div>

</section>

{% endif %}


{# ========================================= #}
{# التطبيقات                                 #}
{# ========================================= #}

{% if site.show_apps != false %}

<section class="section" id="apps">

  <div class="section-head">
    <span>{{ site.apps_section_label }}</span>
    <h2>{{ site.apps_section_title }}</h2>
  </div>

  <div class="cards">

    {% for app in apps.items %}

      <article class="card">

        {% if app.icon %}
          <div class="appicon">
            <img
              src="{{ app.icon }}"
              alt="{{ app.name }}"
              loading="lazy"
            >
          </div>
        {% endif %}

        <h3>{{ app.name }}</h3>

        <p>{{ app.description }}</p>

        {% if app.url %}
          <a
            href="{{ app.url }}"
            target="_blank"
            rel="noopener"
          >
            عرض على Google Play ←
          </a>
        {% endif %}

      </article>

    {% endfor %}

  </div>

</section>

{% endif %}


{# ========================================= #}
{# القسم الأسود                              #}
{# ========================================= #}

{% if site.show_statement != false %}

<section class="statement">

  <p>{{ site.statement_small }}</p>

  <h2>
    {{ site.statement_title }}
  </h2>

</section>

{% endif %}


{# ========================================= #}
{# المقالات                                  #}
{# ========================================= #}

{% if site.show_articles != false %}

<section class="section">

  <div class="section-head">

    <span>
      {{ site.articles_section_label }}
    </span>

    <h2>
      {{ site.articles_section_title }}
    </h2>

  </div>


  <div class="articles">

    {% for post in collections.article | reverse %}

      {% if loop.index <= 3 %}

        <a
          class="article"
          href="{{ post.url }}"
        >

          <h3>
            {{ post.data.title }}
          </h3>

          <p>
            {{ post.data.summary }}
          </p>

        </a>

      {% endif %}

    {% else %}

      <p>
        ستظهر المقالات هنا بعد إضافتها من لوحة الإدارة.
      </p>

    {% endfor %}

  </div>

</section>

{% endif %}


{# ========================================= #}
{# تشغيل سلايدر الأيقونات                    #}
{# ========================================= #}

{% if site.show_slider != false and site.slider_items and site.slider_items | length > 1 %}

<script>
document.addEventListener("DOMContentLoaded", function () {

  const track = document.getElementById("sliderTrack");
  const slides = document.querySelectorAll("#homeSlider .icon-slide");
  const prev = document.getElementById("sliderPrev");
  const next = document.getElementById("sliderNext");

  if (!track || slides.length < 2) {
    return;
  }

  let current = 0;
  let timer = null;


  function getVisibleItems() {

    if (window.innerWidth <= 560) {
      return 2;
    }

    if (window.innerWidth <= 850) {
      return 3;
    }

    return 5;
  }


  function getMaxIndex() {

    const visible = getVisibleItems();

    return Math.max(
      0,
      slides.length - visible
    );
  }


  function updateSlider() {

    const visible = getVisibleItems();

    const itemWidth = 100 / visible;

    slides.forEach(function(slide) {
      slide.style.flexBasis = itemWidth + "%";
    });

    const maxIndex = getMaxIndex();

    if (current > maxIndex) {
      current = maxIndex;
    }

    track.style.transform =
      "translateX(" + (current * itemWidth) + "%)";
  }


  function goNext() {

    const maxIndex = getMaxIndex();

    if (maxIndex === 0) {
      current = 0;
      updateSlider();
      return;
    }

    current++;

    if (current > maxIndex) {
      current = 0;
    }

    updateSlider();
  }


  function goPrev() {

    const maxIndex = getMaxIndex();

    if (maxIndex === 0) {
      current = 0;
      updateSlider();
      return;
    }

    current--;

    if (current < 0) {
      current = maxIndex;
    }

    updateSlider();
  }


  function startAutoPlay() {

    clearInterval(timer);

    timer = setInterval(function() {
      goNext();
    }, 3500);
  }


  if (next) {

    next.addEventListener("click", function() {
      goNext();
      startAutoPlay();
    });

  }


  if (prev) {

    prev.addEventListener("click", function() {
      goPrev();
      startAutoPlay();
    });

  }


  window.addEventListener("resize", function() {
    current = 0;
    updateSlider();
  });


  updateSlider();
  startAutoPlay();

});
</script>

{% endif %}
