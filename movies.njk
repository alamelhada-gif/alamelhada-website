layout: base.njk
title: الأفلام | علم الهدى
description: تصفح أحدث الأفلام على موقع علم الهدى
permalink: /movies/index.html
---

<section class="section" dir="rtl">
  <div class="home-library-heading">
    <div>
      <span class="home-library-label">تطبيق مشاهدة الأفلام</span>
      <h1>أحدث الأفلام</h1>
    </div>
  </div>

  <div id="cinemaMovies" class="cinema-grid">
    <p>جاري تحميل الأفلام...</p>
  </div>
</section>

<style>
.cinema-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 20px;
  margin: 25px 0;
}
.cinema-card {
  display: block;
  color: inherit;
  text-decoration: none;
}
.cinema-card img {
  width: 100%;
  aspect-ratio: 2 / 3;
  object-fit: cover;
  border-radius: 12px;
}
.cinema-card h3 {
  font-size: 15px;
  margin: 10px 0;
}
</style>

<script>
(async function () {
  const container = document.getElementById("cinemaMovies");

  try {
    const response = await fetch(
      "https://cinema-api.alamelhada.workers.dev/content"
    );

    if (!response.ok) throw new Error("API error");

    const items = await response.json();

    const movies = items.filter(
      item => item.kind === "movie"
    );

    container.replaceChildren();

    if (!movies.length) {
      container.textContent = "لا توجد أفلام حاليًا";
      return;
    }

    for (const movie of movies) {
      const link = document.createElement("a");
      link.className = "cinema-card";
      link.href = "/movies/" + encodeURIComponent(movie.id) + "/";

      const poster = document.createElement("img");
      poster.src = movie.poster || "";
      poster.alt = movie.title || "فيلم";
      poster.loading = "lazy";

      const title = document.createElement("h3");
      title.textContent = movie.title || "بدون عنوان";

      link.append(poster, title);
      container.appendChild(link);
    }
  } catch (error) {
    container.textContent = "تعذر تحميل الأفلام حاليًا";
    console.error(error);
  }
})();
</script>
