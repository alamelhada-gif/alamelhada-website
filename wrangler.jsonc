
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alamelhada-website",
  "main": "worker.js",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/library-detail",
      "/library-detail/*"
    ]
  }
}
